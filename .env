# API base URL used by the axios instance.
# In dev this is a relative path proxied by Vite (see vite.config.ts) so the
# browser talks same-origin and avoids CORS. For a deployment that hits the API
# directly, set this to the absolute URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# The real backend the dev proxy forwards /api and /uploads to.
VITE_DEV_API_TARGET=http://localhost:3000
